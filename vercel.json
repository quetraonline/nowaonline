{
  "rewrites": [
    {
      "source": "/iletisim",
      "destination": "/iletisim.html"
    },
    {
      "source": "/rehber",
      "destination": "/rehber.html"
    }
  ],
  "redirects": [
    {
      "source": "/iletisim.html",
      "destination": "/iletisim",
      "permanent": true
    },
    {
      "source": "/rehber.html",
      "destination": "/rehber",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/tiktok-sync",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/tiktok-webhook.js": {
      "maxDuration": 60
    }
  }
}

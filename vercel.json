{
  "rewrites": [
    {
      "source": "/iletisim",
      "destination": "/iletisim.html"
    },
    {
      "source": "/rehber",
      "destination": "/rehber.html"
    }
  ],
  "redirects": [
    {
      "source": "/iletisim.html",
      "destination": "/iletisim",
      "permanent": true
    },
    {
      "source": "/rehber.html",
      "destination": "/rehber",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/rehber",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/iletisim",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
